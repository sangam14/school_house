<div class="sidebar-section">
  <div class="sidebar-section-title"><%= section_display_name(@lesson.section) %></div>
  <%= for lesson <- @section_lessons do %>
    <% active = lesson.name == @lesson.name %>
    <%= link(to: Routes.lesson_path(@conn, :lesson, current_locale(), lesson.section, lesson.name), class: "sidebar-link#{if active, do: " active", else: ""}") do %>
      <span class="check"><%= if active, do: "●", else: "" %></span>
      <%= lesson.title %>
    <% end %>
  <% end %>
</div>
