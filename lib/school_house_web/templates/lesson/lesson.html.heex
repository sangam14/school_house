<section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
  <div class="mb-8">
    <h1 class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight text-on-surface leading-tight mb-4"><%= @lesson.title %></h1>
  </div>

  <%= if @lesson.excerpt do %>
    <div class="bg-surface-secondary border border-border-subtle rounded-design-md p-5 mb-8 text-on-surface-secondary excerpt-box"><%= raw @lesson.excerpt %></div>
  <% end %>

  <div class="mb-10">
    <h2 class="font-heading text-2xl font-bold text-on-surface border-b-2 border-brand-500 pb-2 inline-block mb-4"><%= gettext("Table of Contents") %></h2>
    <div class="prose dark:prose-dark text-on-surface-secondary">
      <%= raw @lesson.table_of_contents %>
    </div>
  </div>

  <div class="prose dark:prose-dark max-w-none">
    <%= raw @lesson.body %>
  </div>

  <blockquote class="mt-12 p-5 bg-surface-secondary border border-border-subtle rounded-design-md text-on-surface-secondary">
    <%= gettext("Caught a mistake or want to contribute to the lesson?") %>
    <a href={"https://github.com/elixirschool/elixirschool/edit/main/lessons/#{@lesson.locale}/#{@lesson.section}/#{@lesson.name}.md"} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-500 hover:text-brand-600 transition-colors">
      <%= gettext("Edit this lesson on GitHub!") %>
    </a>
  </blockquote>
</section>

<%= render("_pagination.html", conn: @conn, next: @lesson.next, previous: @lesson.previous) %>
