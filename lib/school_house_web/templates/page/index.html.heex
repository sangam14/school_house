<!-- Hero Section -->
<section class="relative overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-24 px-4 sm:px-6">
  <div class="absolute -top-[200px] -right-[200px] w-[800px] h-[800px] bg-[radial-gradient(circle,rgba(124,58,237,0.07)_0%,transparent_70%)] pointer-events-none"></div>
  <div class="absolute -bottom-[100px] -left-[100px] w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(124,58,237,0.04)_0%,transparent_70%)] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-brand-50 border border-brand-200 rounded-full text-brand-600 text-xs font-semibold mb-6">
        <span class="w-1.5 h-1.5 bg-brand-500 rounded-full animate-pulse"></span>
        <%= gettext("Translated in 25+ Languages") %>
      </div>
      <h1 class="font-heading text-5xl sm:text-6xl font-extrabold leading-[1.08] tracking-tight text-on-surface mb-6">
        <%= gettext("Learn & Master") %><br>
        <span class="bg-gradient-to-r from-brand-500 via-brand-400 to-purple-400 bg-clip-text text-transparent"><%= gettext("Elixir") %></span>
      </h1>
      <p class="text-lg text-on-surface-secondary leading-relaxed max-w-xl mb-8">
        <%= gettext("The premier destination for learning the Elixir programming language. From first steps to advanced OTP patterns — free, community-driven lessons that grow with you.") %>
      </p>
      <div class="flex flex-wrap gap-3">
        <%= link(to: Routes.lesson_path(@conn, :index, current_locale(), "basics"), class: "inline-flex items-center gap-2 px-7 py-3.5 bg-brand-600 text-white rounded-full font-semibold text-sm hover:bg-brand-700 hover:-translate-y-0.5 hover:shadow-[0_6px_24px_rgba(124,58,237,0.25)] transition-all") do %>
          <%= gettext("Start Learning") %> →
        <% end %>
        <%= link(to: Routes.page_path(@conn, :why, current_locale()), class: "inline-flex items-center px-7 py-3.5 bg-surface-card text-on-surface border border-border-default rounded-full font-semibold text-sm hover:border-brand-400 hover:text-brand-600 hover:-translate-y-0.5 transition-all") do %>
          <%= gettext("Why Elixir?") %>
        <% end %>
      </div>
    </div>
    <div class="hidden lg:block relative">
      <div class="bg-surface-code rounded-design-lg overflow-hidden shadow-design-xl ring-1 ring-brand-500/10">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/[0.06]">
          <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
          <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
          <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 font-mono text-xs text-white/30">hello.ex</span>
        </div>
        <div class="p-6 font-mono text-sm leading-[1.8] text-[#e0dce8] overflow-x-auto">
<span class="text-[#c084fc] font-medium">defmodule</span> <span class="text-[#fbbf24]">Greeter</span> <span class="text-[#c084fc] font-medium">do</span>
  <span class="text-[#5c5470] italic">@moduledoc """
  A friendly greeter for Elixir School
  """</span>

  <span class="text-[#c084fc] font-medium">def</span> <span class="text-[#67e8f9]">hello</span>(name) <span class="text-[#c084fc] font-medium">do</span>
    <span class="text-[#86efac]">"Hello, #{</span>name<span class="text-[#86efac]">}! Welcome to"</span>
    <span class="text-[#f9a8d4]">|&gt;</span> <span class="text-[#fbbf24]">Kernel</span>.<span class="text-[#67e8f9]">&lt;&gt;</span>(<span class="text-[#86efac]">" Elixir School"</span>)
  <span class="text-[#c084fc] font-medium">end</span>

  <span class="text-[#c084fc] font-medium">def</span> <span class="text-[#67e8f9]">greet_all</span>(names) <span class="text-[#c084fc] font-medium">when</span> <span class="text-[#67e8f9]">is_list</span>(names) <span class="text-[#c084fc] font-medium">do</span>
    names
    <span class="text-[#f9a8d4]">|&gt;</span> <span class="text-[#fbbf24]">Enum</span>.<span class="text-[#67e8f9]">map</span>(&amp;<span class="text-[#67e8f9]">hello</span>/&amp;<span class="text-[#fca5a5]">1</span>)
    <span class="text-[#f9a8d4]">|&gt;</span> <span class="text-[#fbbf24]">Enum</span>.<span class="text-[#67e8f9]">join</span>(<span class="text-[#86efac]">"\n"</span>)
  <span class="text-[#c084fc] font-medium">end</span>
<span class="text-[#c084fc] font-medium">end</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Bar -->
<section class="py-12 px-4 sm:px-6 border-t border-b border-border-subtle bg-surface-secondary">
  <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8">
    <div class="text-center">
      <div class="font-heading text-3xl font-extrabold tracking-tight text-brand-500 leading-none mb-1.5">100+</div>
      <div class="text-sm text-on-surface-muted font-medium"><%= gettext("Conferences") %></div>
    </div>
    <div class="text-center">
      <div class="font-heading text-3xl font-extrabold tracking-tight text-brand-500 leading-none mb-1.5">25</div>
      <div class="text-sm text-on-surface-muted font-medium"><%= gettext("Languages") %></div>
    </div>
    <div class="text-center">
      <div class="font-heading text-3xl font-extrabold tracking-tight text-brand-500 leading-none mb-1.5">13K+</div>
      <div class="text-sm text-on-surface-muted font-medium"><%= gettext("Hex Packages") %></div>
    </div>
    <div class="text-center hidden sm:block">
      <div class="font-heading text-3xl font-extrabold tracking-tight text-brand-500 leading-none mb-1.5">600+</div>
      <div class="text-sm text-on-surface-muted font-medium"><%= gettext("Companies Using Elixir") %></div>
    </div>
    <div class="text-center hidden lg:block">
      <div class="font-heading text-3xl font-extrabold tracking-tight text-brand-500 leading-none mb-1.5">50+</div>
      <div class="text-sm text-on-surface-muted font-medium"><%= gettext("Lessons & Guides") %></div>
    </div>
  </div>
</section>

<!-- Why Elixir Features -->
<section class="py-24 px-4 sm:px-6 max-w-7xl mx-auto">
  <div class="text-center mb-14">
    <div class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-brand-500 mb-3"><%= gettext("Why Elixir?") %></div>
    <h2 class="font-heading text-4xl font-extrabold tracking-tight text-on-surface mb-4"><%= gettext("Built for the Modern World") %></h2>
    <p class="text-lg text-on-surface-secondary max-w-xl mx-auto"><%= gettext("Discover why Elixir's popularity has skyrocketed and new companies adopt it daily.") %></p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="group relative bg-surface-card border border-border-subtle rounded-design-lg p-8 transition-all duration-300 hover:border-brand-200 hover:shadow-design-lg hover:-translate-y-1 overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-brand-500 to-brand-300 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="w-12 h-12 rounded-xl bg-brand-100 flex items-center justify-center mb-5">
        <svg fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-brand-600" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      </div>
      <h3 class="font-heading text-xl font-bold text-on-surface mb-3"><%= gettext("Functional Programming") %></h3>
      <p class="text-sm text-on-surface-secondary leading-relaxed mb-4"><%= gettext("Break problems into simple, side-effect free functions. Better test coverage, fewer bugs, and solutions built from well-tested compositions.") %></p>
      <%= link(to: Routes.page_path(@conn, :why, current_locale()), class: "inline-flex items-center text-sm font-medium text-brand-500 hover:text-brand-600 transition-colors") do %>
        <%= gettext("Learn More") %>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      <% end %>
    </div>
    <div class="group relative bg-surface-card border border-border-subtle rounded-design-lg p-8 transition-all duration-300 hover:border-brand-200 hover:shadow-design-lg hover:-translate-y-1 overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-brand-500 to-brand-300 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="w-12 h-12 rounded-xl bg-green-100/60 flex items-center justify-center mb-5">
        <svg fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-accent-green" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h3 class="font-heading text-xl font-bold text-on-surface mb-3"><%= gettext("Feature Packed") %></h3>
      <p class="text-sm text-on-surface-secondary leading-relaxed mb-4"><%= gettext("Built on the Erlang VM (BEAM), battle-tested for 30+ years. Get lightweight processes, fault tolerance, and hot code reloading out of the box.") %></p>
      <%= link(to: Routes.page_path(@conn, :why, current_locale()), class: "inline-flex items-center text-sm font-medium text-brand-500 hover:text-brand-600 transition-colors") do %>
        <%= gettext("Learn More") %>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      <% end %>
    </div>
    <div class="group relative bg-surface-card border border-border-subtle rounded-design-lg p-8 transition-all duration-300 hover:border-brand-200 hover:shadow-design-lg hover:-translate-y-1 overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-brand-500 to-brand-300 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="w-12 h-12 rounded-xl bg-amber-100/60 flex items-center justify-center mb-5">
        <svg fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 text-accent-amber" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="font-heading text-xl font-bold text-on-surface mb-3"><%= gettext("Vibrant Ecosystem") %></h3>
      <p class="text-sm text-on-surface-secondary leading-relaxed mb-4"><%= gettext("Dozens of conferences, hundreds of meetups, an active community across Slack, Discord, and the forum. Plus 13,000+ packages on Hex.") %></p>
      <%= link(to: Routes.page_path(@conn, :why, current_locale()), class: "inline-flex items-center text-sm font-medium text-brand-500 hover:text-brand-600 transition-colors") do %>
        <%= gettext("Learn More") %>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      <% end %>
    </div>
  </div>
</section>

<!-- Blog Posts -->
<%= render(SchoolHouseWeb.PostView, "index.html", conn: @conn, posts: @posts) %>

<!-- CTA Section -->
<section class="py-24 px-4 sm:px-6 bg-surface-secondary border-t border-border-subtle">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-heading text-3xl sm:text-4xl font-extrabold tracking-tight text-on-surface mb-4"><%= gettext("Ready to Get Started?") %></h2>
    <p class="text-lg text-on-surface-secondary mb-8"><%= gettext("Jump into your first lesson and discover why developers love Elixir. Free, open-source, and community-driven.") %></p>
    <div class="flex flex-wrap justify-center gap-3">
      <%= link(to: Routes.lesson_path(@conn, :index, current_locale(), "basics"), class: "inline-flex items-center gap-2 px-7 py-3.5 bg-brand-600 text-white rounded-full font-semibold text-sm hover:bg-brand-700 hover:-translate-y-0.5 hover:shadow-[0_6px_24px_rgba(124,58,237,0.25)] transition-all") do %>
        <%= gettext("Begin with Basics") %> →
      <% end %>
      <%= link(gettext("Browse All Posts"), to: Routes.post_path(@conn, :index), class: "inline-flex items-center px-7 py-3.5 bg-surface-card text-on-surface border border-border-default rounded-full font-semibold text-sm hover:border-brand-400 hover:text-brand-600 hover:-translate-y-0.5 transition-all") %>
    </div>
  </div>
</section>
