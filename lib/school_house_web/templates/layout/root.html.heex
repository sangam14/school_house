<!DOCTYPE html>
<html lang={current_locale()} data-theme={render_dark_mode?(@conn)}>
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <meta charset="UTF-8">
    <meta content={get_csrf_token()} name="csrf-token">

    <.live_title suffix=" · Elixir School"><%= assigns[:page_title] || "Elixir School" %></.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <%= load_locale_styles(view_module(@conn), assigns) %>
    <script phx-track-static src={Routes.static_path(@conn, "/assets/initialize-theme.js")}></script>
    <script defer phx-track-static src={Routes.static_path(@conn, "/assets/app.js")}></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KCQP9HEX0V"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KCQP9HEX0V');
    </script>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="preload font-body bg-surface text-on-surface overflow-x-hidden">
    <%= render "_header.html", conn: @conn %>
    <div class="pt-16">
      <%= @inner_content %>
    </div>
    <%= render "_footer.html", conn: @conn %>
  </body>
</html>
